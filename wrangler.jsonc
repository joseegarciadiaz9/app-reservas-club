{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "totem-reservas",
  // La que traía el proyecto. El deploy la puso en la fecha de hoy y el runtime
  // de desarrollo (miniflare) no llega tan lejos, así que no arrancaba en local.
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
