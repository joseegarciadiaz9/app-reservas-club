# Fourvenues Channel Manager API (integración de reservas de TØTEM)
# Copia este archivo a `.env` (o `.dev.vars` para Wrangler) y rellena la clave.
# La API key es un SECRETO: nunca la subas al repo ni la expongas en el cliente.

# Clave de Channel Manager con permisos de Booking (generada desde el Developer Portal).
FOURVENUES_API_KEY=

# Entorno: "alpha" para pruebas, "prod" para producción.
FOURVENUES_ENV=alpha

# Opcional: sobreescribe la base URL (si no, se deriva de FOURVENUES_ENV).
# alpha → https://channels-service-alpha.fourvenues.com
# prod  → https://channels-service.fourvenues.com
# FOURVENUES_BASE_URL=

# Opcional: external_channel_id por defecto para atribuir el canal de ventas.
# FOURVENUES_CHANNEL_ID=

# --- Acceso a la herramienta (ver worker/access.ts) --------------------------
# Contraseña compartida del equipo de RRPP. OBLIGATORIA en cuanto haya
# FOURVENUES_API_KEY: sin ella la app se bloquea entera en vez de quedar
# abierta (así no se puede desplegar sin protección por descuido).
APP_ACCESS_PASSWORD=

# Opcional: secreto para firmar la cookie de sesión. Si se omite, se deriva de
# APP_ACCESS_PASSWORD. Cambiar cualquiera de los dos cierra las sesiones abiertas.
# APP_SESSION_SECRET=
